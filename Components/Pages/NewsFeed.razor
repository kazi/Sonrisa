@page "/news"
@using Sonrisa.Models
@using Sonrisa.Services
@inject NewsApiService NewsService
@inject NotificationDispatcherService DispatcherService
@rendermode InteractiveServer

<PageTitle>Local Breaking News</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Local Breaking News Feed</h3>
    <button class="btn btn-outline-secondary" @onclick="SyncNewsAsync" disabled="@isSyncing">
        @(isSyncing ? "Syncing..." : "Sync Latest Headlines")
    </button>
    <button class="btn btn-outline-primary" @onclick="DispatchSlackAsync" disabled="@isDispatching">
        @(isDispatching ? "Sending..." : "Dispatch to Slack Subscribers")
    </button>
</div>

@if (!string.IsNullOrEmpty(dispatchStatus))
{
    <div class="alert alert-info mt-2 mb-0 py-2">
        @dispatchStatus
    </div>
}

@if (articles == null)
{
    <p><em>Loading local articles...</em></p>
}
else if (!articles.Any())
{
    <p>No articles stored. Click "Sync Latest Headlines" to pull news from NewsAPI.</p>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var article in articles)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    @if (!string.IsNullOrEmpty(article.UrlToImage))
                    {
                        <img src="@article.UrlToImage" class="card-img-top" alt="Thumbnail" style="height: 180px; object-fit: cover;" />
                    }
                    <div class="card-body d-flex flex-column">
                        <span class="badge bg-secondary mb-2 text-start w-auto">@article.SourceName</span>
                        <h5 class="card-title">@article.Title</h5>
                        <p class="card-text text-muted small">@article.Description</p>
                        <div class="mt-auto d-flex justify-content-between align-items-center">
                            <a href="@article.Url" target="_blank" class="btn btn-primary btn-sm">Read</a>
                            <button class="btn btn-outline-danger btn-sm" @onclick="() => SoftDeleteAsync(article.Id)">
                                Delete
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<NewsArticle>? articles;
    private bool isSyncing = false;
    private bool isDispatching = false;
    private string? dispatchStatus;

    protected override async Task OnInitializedAsync()
    {
        await RefreshLocalArticlesAsync();
    }

    private async Task SyncNewsAsync()
    {
        isSyncing = true;
        await NewsService.SyncAndGetHeadlinesAsync();
        await RefreshLocalArticlesAsync();
        isSyncing = false;
    }

    private async Task SoftDeleteAsync(int id)
    {
        await NewsService.SoftDeleteArticleAsync(id);
        await RefreshLocalArticlesAsync();
    }

    private async Task RefreshLocalArticlesAsync()
    {
        articles = await NewsService.GetLocalArticlesAsync();
    }

    private async Task DispatchSlackAsync()
    {
        isDispatching = true;
        dispatchStatus = null;

        int notifiedCount = await DispatcherService.DispatchTopHeadlinesToSlackAsync(topCount: 3);
        dispatchStatus = $"Successfully dispatched breaking news to {notifiedCount} Slack subscriber(s)!";

        isDispatching = false;
    }
}