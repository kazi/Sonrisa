@page "/admin/login"

<PageTitle>Sonrisa - Admin Login</PageTitle>

<div class="row justify-content-center mt-5">
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white text-center py-3">
                <h5 class="mb-0">Sonrisa Admin Access</h5>
            </div>
            <div class="card-body p-4">
                @if (IsError)
                {
                    <div class="alert alert-danger py-2">
                        Invalid admin password. Please try again.
                    </div>
                }

                <!-- Standard HTML form submitting to Minimal API endpoint to issue HTTP Auth Cookie -->
                <form action="/api/admin/login" method="post">
                    <div class="mb-3">
                        <label for="password" class="form-label">Admin Password</label>
                        <input type="password" id="password" name="password" class="form-control" placeholder="Enter password..." required />
                    </div>
                    <button type="submit" class="btn btn-dark w-100">Log In</button>
                </form>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? Error { get; set; }

    private bool IsError => Error == "invalid_credentials";
}