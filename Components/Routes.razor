@using Microsoft.AspNetCore.Components.Authorization

<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
            <NotAuthorized>
                @if (context.User.Identity?.IsAuthenticated != true)
                {
                    <div class="container text-center my-5">
                        <div class="card shadow-sm p-4 mx-auto" style="max-width: 450px;">
                            <h4 class="mb-3 text-danger">Access Restricted</h4>
                            <p class="text-muted mb-4">You must log in to view the admin area.</p>
                            <a href="/admin/login" class="btn btn-dark w-100">Go to Admin Login</a>
                        </div>
                    </div>
                }
                else
                {
                    <p class="p-4 text-center text-muted">You are not authorized to view this resource.</p>
                }
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Not found</PageTitle>
        <LayoutView Layout="typeof(Layout.MainLayout)">
            <p role="alert" class="p-4">Sorry, there's nothing at this address.</p>
        </LayoutView>
    </NotFound>
</Router>