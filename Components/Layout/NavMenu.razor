@using Microsoft.AspNetCore.Components.Authorization

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Sonrisa</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <!-- Public News & Subscription Home -->
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-newspaper-nav-menu" aria-hidden="true"></span> News headlines
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="subscribe" Match="NavLinkMatch.All">
                <span class="bi bi-newspaper-nav-menu" aria-hidden="true"></span> Subscribe
            </NavLink>
        </div>

        <!-- Protected Admin Dashboard -->
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="admin">
                <span class="bi bi-speedometer2-nav-menu" aria-hidden="true"></span> Admin Dashboard
            </NavLink>
        </div>

        <div class="dropdown-divider my-2 border-secondary"></div>

        <!-- Dynamic Auth Links -->
        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <a class="nav-link text-warning" href="/api/admin/logout">
                        <span class="bi bi-box-arrow-right-nav-menu" aria-hidden="true"></span> Admin Logout
                    </a>
                </div>
            </Authorized>

        </AuthorizeView>
    </nav>
</div>